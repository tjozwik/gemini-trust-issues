{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["allow", "deny"]
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "user_authorization": {
      "type": "string",
      "enum": ["none", "low", "medium", "high"]
    },
    "narrowly_scoped": {
      "type": "boolean"
    },
    "policy_block": {
      "type": "boolean"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    }
  },
  "required": [
    "decision",
    "risk_level",
    "user_authorization",
    "narrowly_scoped",
    "policy_block",
    "rationale"
  ]
}
